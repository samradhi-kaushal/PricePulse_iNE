# ==================================================
# 1. LOCAL DEVELOPMENT CONFIGURATION
# ==================================================
# Local Django API (.env inside apps/api_django/ or root)
DATABASE_URL=
SECRET_KEY=your-local-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=http://localhost:5173
CRON_SECRET=your-local-cron-secret

# Local React Frontend (.env inside apps/web/ or root)
VITE_API_BASE_URL=http://127.0.0.1:8000/api


# ==================================================
# 2. RENDER (DJANGO BACKEND PRODUCTION)
# ==================================================
# Configure these environment variables in the Render Dashboard:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# SECRET_KEY=[GENERATE-STRONG-RANDOM-SECRET-KEY]
# DEBUG=False
# ALLOWED_HOSTS=[YOUR-RENDER-SERVICE-NAME].onrender.com
# CORS_ALLOWED_ORIGINS=https://[YOUR-VERCEL-APP-NAME].vercel.app
# FRONTEND_ORIGIN=https://[YOUR-VERCEL-APP-NAME].vercel.app
# CRON_SECRET=[GENERATE-LONG-RANDOM-SECRET]


# ==================================================
# 3. VERCEL (REACT FRONTEND PRODUCTION)
# ==================================================
# Configure this environment variable in the Vercel Dashboard:
# VITE_API_BASE_URL=https://[YOUR-RENDER-SERVICE-NAME].onrender.com/api
